{
  "appId": "community.tfx.launcher",
  "electronVersion": "43.1.1",
  "productName": "TFX Launcher",
  "electronLanguages": ["en-US", "zh-CN", "zh-TW", "de", "fr"],
  "executableName": "TFX-Launcher",
  "directories": {
    "output": "dist",
    "buildResources": "src/assets/icons"
  },
  "asarUnpack": [
    "src/tools/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "src/assets/icons/icon.ico",
    "signAndEditExecutable": true,
    "signExecutable": false
  },
  "portable": {
    "artifactName": "TFX-Launcher-${version}.exe",
    "requestExecutionLevel": "user"
  },
  "artifactName": "TFX-Launcher-${version}.exe",
  "files": [
    "src/**/*",
    "node_modules/**/*",
    "package.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "!test/**/*",
    "!src/tools/clients/**/payload.zip",
    "!src/app/index.html",
    "!src/assets/bg/tf1.jpg",
    "!src/app/css/**/*",
    "!src/app/fonts/**/*",
    "!src/app/icons/**/*",
    "!src/modules/r1delta.js",
    "!src/tools/vtf/7za.exe"
  ]
}
